---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout title="Sheets & Plates" active="/products">
  <section class="pagebanner">
    <div class="shell">
      <p class="eyebrow" style="color:var(--blue)">Inconel + Stainless Flat Products</p>
      <h1>Sheets & Plates</h1>
      <p>High-quality Inconel sheets and plates with excellent finish, high-temperature strength and corrosion resistance — custom-designed to client requirements.</p>
    </div>
  </section>
  <section class="visual">
    <img src="/product-sheets-plates.webp" alt="Sheets and Plates product photography" />
  </section>
  <section class="section">
    <div class="shell productcontent">
      <aside>Bhansali Metals<br />Product briefing</aside>
      <div>
<h3>Sheets & plates</h3>
<p>We hold expertise in manufacturing an extensive range of high-quality Inconel sheets and plates appreciated worldwide — for structural, mechanical and general engineering. Designed to international standards with excellent finish and resistance to high temperature and corrosion; custom-designed to specific requirements.</p>
        <div class="details">
        <div>
          <b>Range</b>
          <span>0.5 mm to 200 mm thick · 1000 mm to 2500 mm wide · 2500 mm to 12500 mm long · NACE MR 0175 available</span>
        </div>
        <div>
          <b>Grades</b>
          <span>UNS 8800 (Inconel 800) · UNS 8825 (Inconel 825) · UNS 6600 (Inconel 600) · UNS 6601 (Inconel 601) · UNS 6625 (Inconel 625) · Austenitic stainless steels: ASTM 304/304L and ASTM 316/316L · Duplex stainless steel: SAF 2205 / UNS S31803 / EN 1.4462 · Super-duplex stainless steel: SAF 2507 / UNS S32750 / EN 1.4410</span>
        </div>
        </div>
        <p style="margin-top:2rem">
          <a class="button" href="/enquiry">Request a quote <svg class="ic" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
        </p>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
