---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout title="Duplex & Super Duplex" active="/products">
  <section class="pagebanner">
    <div class="shell">
      <p class="eyebrow" style="color:var(--blue)">Duplex alloys</p>
      <h1>Duplex & Super Duplex for industrial applications.</h1>
      <p>Duplex and super-duplex stainless materials for challenging chloride and marine environments.</p>
    </div>
  </section>
  <section class="visual">
    <img src="/product-duplex.webp" alt="Duplex stainless alloy products" />
  </section>
  <section class="section">
    <div class="shell productcontent">
      <aside>Bhansali Metals<br />Product briefing</aside>
      <div>
        <h2>Duplex · super duplex</h2>
        <p>2205 (UNS S31803/S32205) and super-duplex bar, plate, pipe and fittings — double the strength of 316 with far superior chloride resistance for marine, desalination and process plant.</p>
        <div class="details">
        <div>
          <b>Product focus</b>
          <span>2205 bar, plate, pipe, flanges & fittings; super-duplex on request</span>
        </div>
        <div>
          <b>Chemistry</b>
          <span>22Cr · 5Ni · 3Mo · N — PREN ≥ 35</span>
        </div>
        <div>
          <b>Enquiry details</b>
          <span>Grade · form · dimensions · NORSOK / MTC requirements</span>
        </div>
        <div>
          <b>Next step</b>
          <span>Contact the team for availability and technical requirements.</span>
        </div>
        </div>
        <p style="margin-top:2rem">
          <a class="button" href="/enquiry">Request a quote <svg class="ic" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
        </p>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
