---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout title="Stainless Steel Flanges" active="/products">
  <section class="pagebanner">
    <div class="shell">
      <p class="eyebrow" style="color:var(--blue)">Weld Neck · Threaded · Slip-On · Lap Joint · Blind · Socket · RTJ</p>
      <h1>Flanges</h1>
      <p>Seven flange families for high-pressure process connections — each profile explained, all with MTC and TPI support.</p>
    </div>
  </section>
  <section class="visual">
    <img src="/product-flanges.webp" alt="Flanges product photography" />
  </section>
  <section class="section">
    <div class="shell productcontent">
      <aside>Bhansali Metals<br />Product briefing</aside>
      <div>
<h3>Stainless steel flanges</h3>
        <div class="details">
        <div>
          <b>Weld neck flanges</b>
          <span>Create a smooth weld matching pipe thickness and bevel; bore matches pipe ID and transfers pressure into the pipe. For high-pressure service — the most commonly used style.</span>
        </div>
        <div>
          <b>Threaded pipe flanges</b>
          <span>No welding needed — outer thread screws onto the pipe. For small-diameter, high-pressure projects.</span>
        </div>
        <div>
          <b>Slip-on flanges</b>
          <span>The least expensive type in large or small sizes; bore slips over the pipe, then fillet-welded. Ring and hub types by size specification.</span>
        </div>
        <div>
          <b>Lap joint flanges</b>
          <span>Used with a stub end; easily assembled and aligned. For low-pressure service or lines needing frequent reassembly.</span>
        </div>
        <div>
          <b>Blind flanges</b>
          <span>Blanking flanges seal pipelines, pumps or valves to stop flow — also used for pressure testing and as reversible inspection covers allowing expansion.</span>
        </div>
        <div>
          <b>Socket weld flanges</b>
          <span>For high-pressure small-bore pipe: pipe inserts into the socket and is fillet-welded at top for smooth fluid and gas flow.</span>
        </div>
        <div>
          <b>Ring-type joint flanges</b>
          <span>Grooved faces compress against slip-on, blind or weld-neck flanges to prevent leaks under extreme pressure and temperature.</span>
        </div>
        <div>
          <b>Materials</b>
          <span>Austenitic stainless steels: ASTM 304/304L and ASTM 316/316L · Duplex stainless steel: SAF 2205 / UNS S31803 / EN 1.4462 · Super-duplex stainless steel: SAF 2507 / UNS S32750 / EN 1.4410</span>
        </div>
        <div>
          <b>Tables</b>
          <span><a href="/technical/flanges">150 LB dimension tables <svg class="ic" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></span>
        </div>
        </div>
        <p style="margin-top:2rem">
          <a class="button" href="/enquiry">Request a quote <svg class="ic" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
        </p>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
