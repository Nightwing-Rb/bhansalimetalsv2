---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout title="Hastelloy X" active="/products">
  <section class="pagebanner">
    <div class="shell">
      <p class="eyebrow" style="color:var(--blue)">High Nickel Alloys</p>
      <h1>Hastelloy X</h1>
      <p>Severe-service nickel alloy from Bhansali Metals — full forms stocked with MTC and third-party inspection.</p>
    </div>
  </section>
  <section class="visual">
    <img src="/product-hastelloy.webp" alt="Hastelloy X product photography" />
  </section>
  <section class="section">
    <div class="shell productcontent">
      <aside>Bhansali Metals<br />Product briefing</aside>
      <div>
<h3>Hastelloy X</h3>
<p>Hastelloy X is a nickel-chromium-iron-molybdenum superalloy with outstanding high-temperature strength, oxidation resistance and fabricability — oxidation-resistant to 2200°F and exceptionally resistant to stress-corrosion cracking in petrochemical service. Molybdenum matrix-stiffening gives a solid-solution alloy both high strength and good fabrication characteristics. Beyond heat and oxidation resistance it handles chloride stress-corrosion cracking, carburization and reducing/carburizing atmospheres — resisting the carburization and nitriding that cause early failure in lesser high-temperature alloys.</p>
<h3>Forms stocked at Bhansali Metals</h3>
        <div class="details">
        <div>
          <b>Sheet</b>
          <span>Sheet in Hastelloy X</span>
        </div>
        <div>
          <b>Plate</b>
          <span>Plate in Hastelloy X</span>
        </div>
        <div>
          <b>Pipe & Tube (welded and seamless)</b>
          <span>Pipe & Tube (welded and seamless) in Hastelloy X</span>
        </div>
        <div>
          <b>Wire</b>
          <span>Wire in Hastelloy X</span>
        </div>
        <div>
          <b>Bar</b>
          <span>Bar in Hastelloy X</span>
        </div>
        <div>
          <b>Fittings</b>
          <span>Fittings in Hastelloy X</span>
        </div>
        </div>
        <p style="margin-top:2rem">
          <a class="button" href="/enquiry">Request a quote <svg class="ic" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
        </p>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
