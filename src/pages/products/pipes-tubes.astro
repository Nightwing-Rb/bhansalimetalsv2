---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout title="Pipes & Tubes" active="/products">
  <section class="pagebanner">
    <div class="shell">
      <p class="eyebrow" style="color:var(--blue)">Seamless & Welded</p>
      <h1>Pipes & Tubes</h1>
      <p>Stainless & high-nickel pipes for oil & gas, auto, construction & engineering. Seamless + ERW/EFW.</p>
    </div>
  </section>
  <section class="visual">
    <img src="/product-pipes-tubes.webp" alt="Pipes and Tubes product photography" />
  </section>
  <section class="section">
    <div class="shell productcontent">
      <aside>Bhansali Metals<br />Product briefing</aside>
      <div>
        <img class="inline" src="/images/p1.webp" alt="Pipes & Tubes" onerror="this.src='/images/b2.webp'" />
        <p>We offer a wide range of pipes meeting application needs of automotive, oil & gas, engineering, construction & process industries.</p>
  <h3>Range</h3><div class="table-wrap"><table class="data"><tr><th>Param</th><th>Detail</th></tr>
  <tr><td>Type</td><td>Seamless, ERW, EFW</td></tr>
  <tr><td>Size</td><td>1/8” NB – 24” NB, Sch 5S – XXS</td></tr>
  <tr><td>Grades</td><td>304/304L, 316/316L, 310S, 321, 2205, Inconel 600/625/800, Monel 400, Hastelloy C-276/B2</td></tr>
  <tr><td>Ends</td><td>Plain, bevelled, threaded; polished / pickled</td></tr></table></div>
  <p>Hydro-tested, PMI-checked, with MTC. See <a href="/technical/pipe-data">Pipe Data</a> for dimensions & weights.</p>
        <p style="margin-top:2rem">
          <a class="button" href="/enquiry">Request a quote <svg class="ic" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
        </p>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
