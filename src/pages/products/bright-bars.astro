---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout title="Bright Bars — Stainless Steel Rods & Bars" active="/products">
  <section class="pagebanner">
    <div class="shell">
      <p class="eyebrow" style="color:var(--blue)">Rods & Bars • Bright</p>
      <h1>Bright Bars — cold-drawn & polished</h1>
      <p>3mm–135mm, h9/h11, strain-hardened Class 1/2. 100% UT billets, 100+ chemistries.</p>
    </div>
  </section>
  <section class="visual">
    <img src="/product-bright-bars.webp" alt="Bright Bars product photography" />
  </section>
  <section class="section">
    <div class="shell productcontent">
      <aside>Bhansali Metals<br />Product briefing</aside>
      <div>
        <img class="inline" src="/images/rod-and-platsa11.webp" alt="Bright bars" onerror="this.src='/images/b2.webp'" />
        <p>Our high-end manufacturing programme facilitates high-quality rods and bars. Own casting capacity gives flexibility to manufacture 100+ chemical compositions with excellent mechanical properties.</p>
        <p>Rods and bars are manufactured from in-house billets, 100% ultrasonic-controlled after homogenisation — trusted in automotive, aircraft & space industries.</p>
        <p>Cold working (drawing) on standard machines & continuous lines. All standard dimensions to international standards. Special care for harder alloys, stress-free states, free-cutting alloys & blanks.</p>
        <h3>Bright bar size ranges</h3>
        <div class="table-wrap"><table class="data"><tr><th>Condition</th><th>Size</th></tr>
        <tr><td>Cold Drawn, Ground Polished</td><td>3mm – 22mm (1/8”–7/8”)</td></tr>
        <tr><td>Smooth & Polished</td><td>25mm – 85mm (1”–3¼”)</td></tr>
        <tr><td>Smooth / Rough Turned</td><td>100, 105, 110, 120, 135mm</td></tr></table></div>
        <h3>Grades</h3>
        <p>AISI 201, 201Cu, 202, 204Cu, 303, 304, 304L, 316, 316L, 316Ti, 317LN, 310S, 321, 347, 410, 416, 420, 420B, 409Ti, 430, 430L, 430F, 431, 17-4PH, 2205 / 31803 & others.</p>
        <p><strong>Tolerance:</strong> h9, h11 as per ASTM A484 / DIN 671 & DIN 1013.</p>
        <h3>Strain-hardened (ASTM A193)</h3>
        <div class="table-wrap"><table class="data"><tr><th>Param</th><th>Detail</th></tr>
        <tr><td>Size</td><td>10mm – 42mm</td></tr><tr><td>Spec</td><td>ASTM A193 / A193M</td></tr>
        <tr><td>Class</td><td>Class 1 or Class 2</td></tr><tr><td>Grade</td><td>B8 (304) / B8M (316)</td></tr>
        <tr><td>Length</td><td>6–6.1 m / 12–12.2 ft</td></tr></table></div>
        <h3>Hexagonal & square bars (bright)</h3>
        <div class="table-wrap"><table class="data"><tr><th>Param</th><th>Detail</th></tr>
        <tr><td>Size</td><td>10mm – 40mm (¼”–1½”)</td></tr><tr><td>Grade</td><td>304, 304L, 316, 316L</td></tr>
        <tr><td>Length</td><td>3–4 m / 12–12.2 ft</td></tr><tr><td>Tolerance</td><td>ASTM A484 / h11</td></tr></table></div>
        <h3>Threaded bars</h3>
        <div class="table-wrap"><table class="data"><tr><th>Param</th><th>Detail</th></tr>
        <tr><td>Size</td><td>M6 – M64 (¼”–2½”)</td></tr><tr><td>Grade</td><td>304, 304L, 316, 316L</td></tr>
        <tr><td>Length</td><td>1 / 2 / 3 / 4 m</td></tr></table></div>
        <h3>Stainless wire</h3>
        <div class="table-wrap"><table class="data"><tr><th>Param</th><th>Detail</th></tr>
        <tr><td>Size</td><td>0.6mm – 8mm</td></tr>
        <tr><td>Grades</td><td>201, 201Cu, 202, 204Cu, 302, 302HQ, 303, 304, 304L, 316, 316L, 308LER, 316Ti, 316LER, 430L & others</td></tr>
        <tr><td>Finish</td><td>Bright drawn, shiny, matte, coated / de-coated</td></tr>
        <tr><td>Hardness</td><td>Soft, 1/8 – full hard</td></tr></table></div>
        <p style="margin-top:2rem">
          <a class="button" href="/enquiry">Request a quote <svg class="ic" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
        </p>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
