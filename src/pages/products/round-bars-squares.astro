---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout title="Round Bars, Squares & Hexagons" active="/products">
  <section class="pagebanner">
    <div class="shell">
      <p class="eyebrow" style="color:var(--blue)">Bright & Black • All Shapes</p>
      <h1>Round Bars, Squares & Hexagons</h1>
      <p>Round, square & hex bars in 100+ chemistries — machining blanks, free-cutting & stress-free options.</p>
    </div>
  </section>
  <section class="visual">
    <img src="/product-round-bars.webp" alt="Round, Square and Hex Bars product photography" />
  </section>
  <section class="section">
    <div class="shell productcontent">
      <aside>Bhansali Metals<br />Product briefing</aside>
      <div>
        <img class="inline" src="/images/b4.webp" alt="Round Bars, Squares & Hexagons" onerror="this.src='/images/b2.webp'" />
        <p>Our round bars in all standard dimensions comply with international standards. Special attention to harder alloys, stress-free states, free-cutting alloys and blanks for CNC shops.</p>
  <h3>Range</h3><div class="table-wrap"><table class="data"><tr><th>Shape</th><th>Size</th></tr>
  <tr><td>Round (bright / black)</td><td>3mm – 400mm dia</td></tr>
  <tr><td>Square</td><td>10mm – 100mm</td></tr>
  <tr><td>Hexagon</td><td>10mm – 65mm A/F</td></tr>
  <tr><td>Coil / wire rod</td><td>0.6mm – 16mm</td></tr></table></div>
  <p>Grades: 200 / 300 / 400 series, duplex 2205, 17-4PH. Lengths 3–6.1m, cut pieces available.</p>
        <p style="margin-top:2rem">
          <a class="button" href="/enquiry">Request a quote ↗</a>
        </p>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
