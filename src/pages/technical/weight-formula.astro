---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout title="Weight Calculation Formula" active="/technical">
  <PageHero eyebrow="Technical Library" title="Weight Calculation Formula" description="Mill weight formulae exactly as used on our shop floor — plus tensile-strength conversions. Try the interactive calculator below." />
  <section class="section">
    <div class="container layout-2col">
      <div class="prose">
<h3>Weight formulae</h3>
        <div class="details">
        <div>
          <b>Stainless pipes &amp; tubes</b>
          <span>OD (mm) − W.T. (mm) × W.T. (mm) × 0.02466 = kg per mtr</span>
        </div>
        <div>
          <b>Sheet width for rolled &amp; welded pipe</b>
          <span>O.D. (mm) − THK (mm) × 3.14 = sheet width</span>
        </div>
        <div>
          <b>Stainless sheets</b>
          <span>Length (mtr) × Width (mtr) × Thk (mm) × 8 = kg per sheet</span>
        </div>
        <div>
          <b>Circles &amp; blanks</b>
          <span>OD (mm) × OD (mm) × Thk (mm) / 160 / 1000 = kg per pc</span>
        </div>
        <div>
          <b>Stainless rounds</b>
          <span>Dia (mm) × Dia (mm) × 0.00623 = kg per mtr</span>
        </div>
        <div>
          <b>Hexagonal rods</b>
          <span>Dia (mm) × Dia (mm) × 0.00679 = kg per mtr</span>
        </div>
        <div>
          <b>Square bars</b>
          <span>Dia (mm) × Dia (mm) × 0.00787 = kg per mtr</span>
        </div>
        <div>
          <b>Carbon steel pipes &amp; tubes</b>
          <span>Dia − W.T. × W.T. × 0.02466 = kg per mtr</span>
        </div>
        <div>
          <b>Carbon steel sheets &amp; plates</b>
          <span>Length × Width × Thk × 7.85 = kg per sheet</span>
        </div>
        <div>
          <b>Copper pipes</b>
          <span>OD − W.T. × W.T. × 0.0256 = kg per mtr</span>
        </div>
        <div>
          <b>Lead pipes (approx.)</b>
          <span>OD − W.T. × W.T. × 0.0345 = kg per mtr</span>
        </div>
        <div>
          <b>Lead sheets (approx.)</b>
          <span>Length × Width × Thk × 11.2 = kg per sheet</span>
        </div>
        <div>
          <b>Aluminium pipes (approx.)</b>
          <span>OD − W.T. × W.T. × 0.0082 = kg per mtr</span>
        </div>
        <div>
          <b>Aluminium sheets (approx.)</b>
          <span>Length × Width × Thk × 2.66 = kg per sheet</span>
        </div>
        </div>
<h3>Tensile strength conversions</h3>
        <div class="details">
        <div>
          <b>kg/mm² → N/mm² (MPa)</b>
          <span>kg/mm² × 9.81</span>
        </div>
        <div>
          <b>PSI → kg/mm²</b>
          <span>PSI × 0.0007</span>
        </div>
        <div>
          <b>KSI → PSI</b>
          <span>KSI × 1000</span>
        </div>
        <div>
          <b>kg/mm² → KSI</b>
          <span>kg/mm² × 1.422</span>
        </div>
        </div>
      </div>
