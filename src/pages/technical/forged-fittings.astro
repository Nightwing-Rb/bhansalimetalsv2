---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout title="Forged Fittings" active="/technical">
  <PageHero eyebrow="Technical Library" title="Forged Fittings" description="Socket-weld and threaded forged fittings to ASME B16.11 — ⅛″ to 4″ NB, Class 150#–9000#." />
  <section class="section">
    <div class="container layout-2col">
      <div class="prose">
<h3>Forged fittings (ASME B16.11)</h3>
<p>Elbows, tees, couplings, unions, caps, plugs, bushings, threadolets and sockolets in socket-weld and screwed ends.</p>
        <div class="details">
        <div>
          <b>Size range</b>
          <span>⅛″ NB to 4″ NB, socket-weld and threaded</span>
        </div>
        <div>
          <b>Pressure class</b>
          <span>150#, 300#, 600#, 900#, 1500#, 2000#, 3000#, 6000#, 9000#</span>
        </div>
        <div>
          <b>Unions</b>
          <span>½″ NB to 4″ NB, socket-weld and screwed</span>
        </div>
        <div>
          <b>Threadolets</b>
          <span>15 NB to 80 NB, zero-error precision machining, close tolerances</span>
        </div>
        <div>
          <b>Grades</b>
          <span>Inconel 600/601/625/718/X-750/800/800H/825 · 304/304L · 316/316L · 2205 duplex · 2507 super-duplex</span>
        </div>
        </div>
      </div>
