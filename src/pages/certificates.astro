---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
---
<BaseLayout title="Certificates" active="/certificates">
  <PageHero eyebrow="Certified & Traceable" title="Certificates & test assurance" description="Every lot ships with a Material Test Certificate. Third-party inspection arranged with leading agencies." crumbs={[{label:'Certificates'}]} />
  <section class="section">
    <div class="container layout-2col">
      <div class="prose" style="text-align:center">
        <h3 style="text-align:left">Mill Test Certificate (MTC)</h3>
        <p style="text-align:left">We supply MTC with chemistry, mechanical properties, heat numbers and dimensional reports. Gate pass & excise documentation included. Third-party inspection available on request.</p>
        <img src="/images/certificate_bhansali.webp" alt="Bhansali Metals certificate" style="border-radius:14px; box-shadow:var(--shadow-md); max-height:640px; margin-inline:auto" />
        <div style="display:flex; gap:10px; justify-content:center; margin-top:18px; flex-wrap:wrap">
          <a class="btn btn-primary" href="/enquiry">Request MTC Copy <svg class="ic" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
          <a class="btn btn-ghost" href="/quality">Our QC Process</a>
        </div>
      </div>
      <aside class="sidebar-card"><h4>Third-Party Inspection</h4>
        <p style="font-size:.9rem">BV • SGS • TUV • DNV • EIL • PDIL and other agencies welcomed at our works.</p>
        <div class="inspect-badges" style="filter:none">
          <img src="/images/1.webp" alt="tpi" /><img src="/images/2.webp" alt="tpi" /><img src="/images/3.webp" alt="tpi" />
          <img src="/images/4.webp" alt="tpi" /><img src="/images/5.webp" alt="tpi" /><img src="/images/6.webp" alt="tpi" />
        </div>
        <a href="/contactus">Arrange inspection <svg class="ic" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
      </aside>
    </div>
  </section>
  <CtaBand /><div style="height:28px"></div>
</BaseLayout>
