---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
---
<BaseLayout title="Certificates" active="/certificates">
  <PageHero eyebrow="Certified & Traceable" title="Certificates & test assurance" description="Every lot ships with a Material Test Certificate. Third-party inspection arranged with leading agencies." crumbs={[{label:'Certificates'}]} />
  <section class="section">
    <div class="container layout-2col">
      <div class="prose" style="text-align:center">
        <h3 style="text-align:left">Mill Test Certificate (MTC)</h3>
        <p style="text-align:left">We supply MTC with chemistry, mechanical properties, heat numbers and dimensional reports. Gate pass & excise documentation included. Third-party inspection available on request.</p>
        <img src="/images/certificate_bhansali.jpg" alt="Bhansali Metals certificate" style="border-radius:14px; box-shadow:var(--shadow-md); max-height:640px; margin-inline:auto" />
        <div style="display:flex; gap:10px; justify-content:center; margin-top:18px; flex-wrap:wrap">
          <a class="btn btn-primary" href="/enquiry">Request MTC Copy →</a>
          <a class="btn btn-ghost" href="/quality">Our QC Process</a>
        </div>
      </div>
      <aside class="sidebar-card"><h4>Third-Party Inspection</h4>
        <p style="font-size:.9rem">BV • SGS • TUV • DNV • EIL • PDIL and other agencies welcomed at our works.</p>
        <div class="inspect-badges" style="filter:none">
          <img src="/images/1.png" alt="tpi" /><img src="/images/2.png" alt="tpi" /><img src="/images/3.png" alt="tpi" />
          <img src="/images/4.png" alt="tpi" /><img src="/images/5.png" alt="tpi" /><img src="/images/6.png" alt="tpi" />
        </div>
        <a href="/contactus">Arrange inspection →</a>
      </aside>
    </div>
  </section>
  <CtaBand /><div style="height:28px"></div>
</BaseLayout>
